# Copy to .env.local. Set the same values in the Vercel dashboard.

# From @BotFather. Validates initData and sends DMs.
BOT_TOKEN=

# t.me link to the Mini App; share links are "<this>?startapp=CODE".
VITE_INVITE_LINK_BASE=https://t.me/keat_hong_guard_house_bot/app

# Raw https origin (web_app buttons reject t.me links). Webhook = $WEB_APP_URL/api/bot.
WEB_APP_URL=https://keat-hong-guard-house.vercel.app

# Generate: openssl rand -hex 32. Then run `bun run telegram:setup`.
TELEGRAM_WEBHOOK_SECRET=

# Vercel dashboard → Storage → your DB.
POSTGRES_URL=
