# Telegram bot token — used server-side to validate WebApp initData signatures.
BOT_TOKEN=

# t.me deep link base for the Mini App (bot username + app short name), used
# to build shareable "?startapp=CODE" invite links. Change this if the bot or
# app short name ever changes. Must be prefixed VITE_ to be exposed
# client-side; also read directly via process.env in api/_telegram.ts to
# build the "View Group" button link for outbound notifications.
VITE_INVITE_LINK_BASE=https://t.me/keat_hong_guard_house_bot/app

# Public HTTPS origin of the deployed Mini App. Required by api/bot.ts and
# scripts/setup-telegram.ts: Telegram's web_app buttons and setChatMenuButton
# only accept a raw https:// URL — the t.me link above is rejected there.
# Also used to derive the webhook URL as "$WEB_APP_URL/api/bot".
WEB_APP_URL=https://keat-hong-guard-house-6vg5.vercel.app

# Shared secret Telegram echoes back in the X-Telegram-Bot-Api-Secret-Token
# header on every webhook request; grammY rejects mismatches with a 401.
# Generate once with:  openssl rand -hex 32
# Must be set here AND in the Vercel dashboard, then `bun run telegram:setup`.
TELEGRAM_WEBHOOK_SECRET=

# Vercel Postgres connection string — auto-provided when you link a Vercel Postgres DB.
# Locally: copy from Vercel dashboard → Storage → your DB → .env.local
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
